# ===========================================
# LOCAL DEVELOPMENT
# ===========================================

# Neon PostgreSQL (use pooled connection string)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Better Auth Configuration
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>
BETTER_AUTH_URL=http://localhost:3000

# Backend JWT Verification
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# PRODUCTION (Vercel + Railway)
# ===========================================
#
# --- Frontend (Vercel) Environment Variables ---
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# BETTER_AUTH_SECRET=your-production-secret
# BETTER_AUTH_URL=https://your-app.vercel.app
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
#
# --- Backend (Railway) Environment Variables ---
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# BETTER_AUTH_URL=https://your-app.vercel.app
# BETTER_AUTH_JWKS_URL=https://your-app.vercel.app/api/auth/jwks
# BETTER_AUTH_ISSUER=https://your-app.vercel.app
# BETTER_AUTH_AUDIENCE=https://your-app.vercel.app
# ALLOWED_ORIGINS=https://your-app.vercel.app
